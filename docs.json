{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gamecart Docs",
  "colors": {
    "primary": "#b355fe",
    "light": "#c77dff",
    "dark": "#6b1fa8"
  },
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#ffffff",
      "dark": "#050607"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "tutorials/overview"
            ]
          },
          {
            "group": "Store setup",
            "pages": [
              "tutorials/store-setup/create-store",
              "tutorials/store-setup/products",
              "tutorials/store-setup/custom-domain",
              "tutorials/store-setup/payment-gateways"
            ]
          },
          {
            "group": "Server delivery",
            "pages": [
              "tutorials/server-delivery/overview"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "tutorials/dashboard/push-notifications"
            ]
          },
          {
            "group": "Payment gateway guides",
            "hidden": true,
            "searchable": true,
            "pages": [
              "tutorials/store-setup/payment-gateways/stripe",
              "tutorials/store-setup/payment-gateways/paypal",
              "tutorials/store-setup/payment-gateways/mercado-pago",
              "tutorials/store-setup/payment-gateways/pix",
              "tutorials/store-setup/payment-gateways/efi",
              "guides/custom-gateways"
            ]
          },
          {
            "group": "Server delivery guides",
            "hidden": true,
            "searchable": true,
            "pages": [
              "tutorials/server-delivery/connect-server",
              "tutorials/server-delivery/minecraft",
              "tutorials/server-delivery/hytale",
              "tutorials/server-delivery/fivem",
              "tutorials/server-delivery/minecraft-rcon",
              "tutorials/server-delivery/configure-commands",
              "tutorials/server-delivery/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code-2",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/api-tokens",
              "api-reference/rate-limits",
              "api-reference/errors",
              "api-reference/pagination",
              "api-reference/changelog"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi/seller-v1.yaml"
          }
        ]
      },
      {
        "tab": "Webhooks",
        "icon": "radio-tower",
        "groups": [
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/overview",
              "webhooks/signatures",
              "webhooks/testing-and-delivery-logs"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://gamecart.gg",
          "icon": "globe"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/gamecart",
          "icon": "message-circle"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/mark.png",
    "dark": "/logo/mark.png",
    "href": "https://gamecart.gg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://discord.gg/gamecart"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.gamecart.gg"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "php",
        "go",
        "java",
        "ruby"
      ]
    }
  }
}
